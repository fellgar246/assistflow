# Profile A: local execution, no AWS account required.
EXECUTION_MODE=local
AWS_ENABLED=false
# Token issuer. Empty in local mode, which uses the process-local issuer.
# aws-demo and showcase require a non-local issuer and refuse to start otherwise.
AUTH_ISSUER=
AUTH_AUDIENCE=
# JWKS document. Empty uses {AUTH_ISSUER}/.well-known/jwks.json.
AUTH_JWKS_URL=
AGENTCORE_ENABLED=false
# ARN of a hosted runtime. Empty while the hosted agent is off. Chat does not call it.
AGENTCORE_RUNTIME_ARN=
# Seconds before a hosted invocation fails and the conversation stays usable.
AGENTCORE_INVOCATION_TIMEOUT_SECONDS=30
# Hosted tool gateway. Empty while the hosted agent is off. Local reads do not call it.
AGENTCORE_GATEWAY_URL=
# Credential the runtime presents to the gateway. Leave empty in this file.
AGENTCORE_GATEWAY_TOKEN=
# Secret for the signed tenant context. Leave empty in this file.
AGENTCORE_ACTOR_CONTEXT_SECRET=
BEDROCK_ENABLED=false
# RAG_PROVIDER=local uses the in-process index. It does not call a hosted embedding API.
# s3 reads documents synced from this repository. managed requires MANAGED_RAG_ENABLED=true.
RAG_PROVIDER=local
# Bucket for RAG_PROVIDER=s3. Leave empty while retrieval stays local.
KNOWLEDGE_BUCKET=
# Object keys are tenants/{tenant_id}/ followed by the product file path.
KNOWLEDGE_KEY_PREFIX=tenants/{tenant_id}/
# Shared knowledge base id. Also set MANAGED_RAG_METADATA_KEY.
MANAGED_KNOWLEDGE_BASE_ID=
# Optional tenant_id=knowledge_base_id pairs, separated by commas.
MANAGED_KNOWLEDGE_BASES=
# Metadata attribute that isolates a shared knowledge base by tenant.
MANAGED_RAG_METADATA_KEY=
RETRIEVAL_SCORE_FLOOR=0.28
MAX_CHUNKS_PER_RETRIEVAL=4
MAX_RETRIEVALS_PER_TURN=2
# AI_ENABLED=true runs the in-process assistant. It does not call a hosted model.
AI_ENABLED=true
# MODEL_PROVIDER=mock uses the local scripted adapter. bedrock requires BEDROCK_ENABLED=true.
MODEL_PROVIDER=mock
# Model id for the hosted adapter. Ignored while MODEL_PROVIDER=mock.
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Extra filter for the hosted model. Off unless BEDROCK_ENABLED and GUARDRAILS_ENABLED are both true.
GUARDRAILS_ENABLED=false
# Guardrail resource id. Leave empty while the filter is off. An enabled filter with no id refuses the turn.
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
# Strengths for the hosted filter. NONE, LOW, MEDIUM, or HIGH.
GUARDRAIL_HARMFUL_CONTENT_STRENGTH=MEDIUM
GUARDRAIL_DENIED_TOPIC_STRENGTH=HIGH
GUARDRAIL_SENSITIVE_INFORMATION_STRENGTH=HIGH
GUARDRAIL_PROMPT_ATTACK_STRENGTH=HIGH
# Optional grounding threshold from 0 to 1. Empty leaves the check off. Order facts still come from tools.
GUARDRAIL_CONTEXTUAL_GROUNDING_THRESHOLD=
# TRACE_DEBUG=true stores a short local summary of model text. It stays off by default.
TRACE_DEBUG=false
LONG_TERM_MEMORY_ENABLED=false
# Last order and shipment status for the current conversation. Off by default.
# A hosted memory client is built only when this and AGENTCORE_ENABLED are both true.
SHORT_TERM_MEMORY_ENABLED=false
# Hosted memory resource. Leave empty while memory stays in the local database.
AGENTCORE_MEMORY_ID=
MANAGED_RAG_ENABLED=false
# Hard stop. true forces the assistant and every hosted feature off. Chat still stores an acknowledgement.
LOCAL_ONLY_MODE=false
# aws-demo drops bulky fields on successful traces. Failures keep the correlation id.
LOG_SUCCESS_SAMPLING=
# Side effects run after the response. Off keeps the in-process queue and builds no AWS client.
ASYNC_WORKERS_ENABLED=false
# Fraction of resolved conversations marked for later evaluation. From 0 to 1.
EVAL_SAMPLE_RATE=0.05
# Hosted evaluations. Off leaves that client unconstructed. The local suite is the check.
HOSTED_EVALUATIONS=false
# Qualitative judge. Off records those scores as not run and does not call a model.
EVAL_JUDGE_ENABLED=false
# EventBridge bus. Used only when async workers and AWS are both on.
EVENT_BUS_NAME=
# SQS queue. Used when the bus name is empty and async workers are on.
EVENT_QUEUE_URL=
# CloudWatch metrics. Published only when AWS_ENABLED and METRICS_ENABLED are both true.
METRICS_ENABLED=false

# Local PostgreSQL started by Docker Compose.
DATABASE_URL=postgresql+psycopg://assistflow:assistflow@localhost:54329/assistflow

# Cloud credentials are never stored in this repository.
# Supply them through the environment only when a later, explicit cloud profile is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
